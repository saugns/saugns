// Early test script producing three sound sequences using PM.
// Revised to sound like a half-good "sound test" by adding envelopes.
'0	Wsin f600 t.1 p[
		Wsin r((3+(1/3))/1) p[
			Wsin r(4/3) a2.e[e.lxpe a0.03.llin r0.01]
		] a2.e[e.lxpe a0.03.llin d0.03 s1/4 r0.01]
	]
	; f550 t.1
	; f500 t.1
	; f450 t.1
	; f400 t.1
	; f350 t.1
	; f300 t.1
	; f250 t.1
	; f200 t.1
	; f150 t.1
	; f100 t.1
	; f150 t.1
	; f200 t.1
	; f250 t.1
	; f300 t.1
	; f350 t.1
	; f400 t.1
	; f450 t.1
	; f500 t.1
	; f550 t.1 |
/2

'a	Wsin f444 p[
		Wsin r(1/1.23456789) a.e[a0.2 d0.2 s1/2 rs]
		; r7.12
	] |
	@a t1 p-[Wsin r2.255 a.e[a0.2 d0.2 s1/2 rs]] |
'b	Wsin f444 t1 p[Wsin f(444 * (2.255)) a.e[a0.3 d0.3 s1/2 rs]] |
